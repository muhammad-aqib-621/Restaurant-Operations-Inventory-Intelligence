# Example only. `npm run env:init` generates .env with a random LOCAL database password.
# Never use this example or the development initializer for a production deployment.
NODE_ENV=development
POSTGRES_USER=nk_dev
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_DB=nk_operations
POSTGRES_PORT=5432
# URL-encode reserved characters in manually supplied credentials.
DATABASE_URL=postgresql://nk_dev:replace-with-a-random-local-password@127.0.0.1:5432/nk_operations?schema=public
API_HOST=127.0.0.1
API_PORT=4000
WEB_HOST=127.0.0.1
WEB_PORT=5173
APP_ORIGIN=http://127.0.0.1:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
# Development seed only. env:init generates a random value; never use in production.
DEMO_PASSWORD=replace-with-a-strong-development-only-password
TRUST_PROXY=false
